# Copy to .env and fill in. Nothing here is committed (.env is gitignored).

# ---- PRIMARY runtime: TrueFoundry AI Gateway --------------------------------
# Personal Access Token from the TrueFoundry dashboard.
TRUEFOUNDRY_API_KEY=
# Your tenant's gateway. Verified reachable for the `pacific` tenant.
TRUEFOUNDRY_BASE_URL=https://pacific.truefoundry.cloud/api/llm
# Gateway model ids are {provider-account}/{model}. Confirm what your tenant
# exposes:  python run_agent.py --list-models
TRUEFOUNDRY_MODEL=ms-openai-main/gpt-4o

# ---- Direct providers (fallbacks; the gateway is the demo path) -------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# MODEL=gpt-4o

# ---- Where the agent sends events / asks for approval -----------------------
AGENT_BUS_URL=http://localhost:8500
MOCK_ENV_URL=http://localhost:8000
# AUTO_APPROVE=1        # unattended run for recording; stamped by="auto"

# ---- Layer 2: real GitHub revert PR -----------------------------------------
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
# Dry-run until this is exactly "1".
GITHUB_REVERT_ENABLED=
